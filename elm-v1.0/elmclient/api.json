    "/api/transaction/confirmOrder": {
      "post": {
        "summary": "确认订单并转移资金",
        "description": "确认订单，将买家冻结资金转移到卖家账户",
        "tags": ["订单资金处理"],
        "parameters": [
          {
            "name": "orderId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "订单ID"
          },
          {
            "name": "buyerId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "买家用户ID"
          },
          {
            "name": "sellerId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "卖家用户ID"
          }
        ],
        "responses": {
          "200": {
            "description": "订单确认成功，资金已转移",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpResultTransaction"
                }
              }
            }
          },
          "500": {
            "description": "订单确认失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpResult"
                }
              }
            }
          }
        }
      }
    },
