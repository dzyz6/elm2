{
  "openapi": "3.0.3",
  "info": {
    "title": "ELM餐饮管理系统 - 完整API文档",
    "description": "ELM餐饮管理系统的完整API接口文档，包含积分模块、交易模块和钱包模块的所有接口",
    "version": "1.0.0",
    "contact": {
      "name": "ELM开发团队",
      "email": "dev@elm.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "本地开发环境"
    }
  ],
  "paths": {

    "/api/points/getPoints": {
      "get": {
        "summary": "获取积分账户",
        "description": "根据用户ID获取积分账户信息",
        "tags": ["积分账户管理"],
        "parameters": [
          {
            "name": "userid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "用户ID"
          }
        ],
        "responses": {
          "200": {
            "description": "成功获取积分账户信息",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpResultPoints"
                }
              }
            }
          },
          "500": {
            "description": "获取积分账户信息失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/points/addPoints": {
      "post": {
        "summary": "添加积分",
        "description": "根据规则为用户添加积分",
        "tags": ["积分交易"],
        "parameters": [
          {
            "name": "userid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "用户ID"
          },
          {
            "name": "channel",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "积分来源渠道（ORDER、COMMENT、ACTIVITY等）"
          },
          {
            "name": "amount",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double"
            },
            "description": "金额或数量（用于计算积分）"
          },
          {
            "name": "relatedId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "关联业务ID（可选）"
          },
          {
            "name": "description",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "积分描述（可选）"
          }
        ],
        "responses": {
          "200": {
            "description": "积分添加成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpResultPoints"
                }
              }
            }
          },
          "500": {
            "description": "积分添加失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/points/consumePoints": {
      "post": {
        "summary": "消费积分",
        "description": "消费用户积分（优先使用快过期的积分）",
        "tags": ["积分交易"],
        "parameters": [
          {
            "name": "userid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "用户ID"
          },
          {
            "name": "pointsAmount",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "要消费的积分数量"
          },
          {
            "name": "channel",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "消费渠道（EXCHANGE、DEDUCTION等）"
          },
          {
            "name": "relatedId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "关联业务ID（可选）"
          },
          {
            "name": "description",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "消费描述（可选）"
          }
        ],
        "responses": {
          "200": {
            "description": "积分消费成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpResultPoints"
                }
              }
            }
          },
          "500": {
            "description": "积分消费失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpResult"
                }
              }
            }
          }
        }
      }
    },
