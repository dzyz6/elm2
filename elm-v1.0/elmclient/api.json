          },
          "money": {
            "type": "number",
            "format": "double",
            "description": "交易金额"
          },
          "type": {
            "type": "integer",
            "enum": [0, 1, 2, 3, 4, 5, 6, 7, 8],
            "description": "交易类型：0-充值, 1-提现, 2-支付, 3-冻结, 4-解冻, 5-透支, 6-还款, 7-利息, 8-其他"
          },
          "fromwallet": {
            "type": "integer",
            "format": "int64",
            "description": "付款方钱包ID（充值等无付款方的交易可以为null）"
          },
          "towallet": {
            "type": "integer",
            "format": "int64",
            "description": "收款方钱包ID（提现等无收款方的交易可以为null）"
          },
          "status": {
            "type": "integer",
            "enum": [0, 1, 2, 3],
            "description": "交易状态：0-待处理, 1-已完成, 2-失败, 3-已取消（创建时可选，默认待处理）"
          },
          "orderId": {
            "type": "integer",
            "format": "int64",
            "description": "关联的订单ID（可选）"
          },
          "description": {
            "type": "string",
            "description": "交易描述（可选）"
          }
        },
        "required": ["money", "type"]
      },
