    "/api/transaction/updateTransaction": {
      "post": {
        "summary": "更新交易状态",
        "description": "根据交易ID更新交易状态",
        "tags": ["交易管理"],
        "parameters": [
          {
            "name": "transactionId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "交易ID"
          },
          {
            "name": "status",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "enum": [0, 1, 2, 3],
              "description": "交易状态：0-待处理, 1-已完成, 2-失败, 3-已取消"
