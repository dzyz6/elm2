  "components": {
    "schemas": {
      "Wallet": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "userid": {
            "type": "integer",
            "format": "int64"
          },
          "money": {
            "type": "number",
            "format": "double"
          },
          "frozenMoney": {
            "type": "number",
            "format": "double"
          },
          "overdraftLimit": {
            "type": "number",
            "format": "double"
          },
          "overdraftAmount": {
            "type": "number",
            "format": "double"
          },
          "overdraftTime": {
            "type": "string",
            "format": "date-time"
          },
          "isVip": {
            "type": "boolean"
          }
        }
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "type": {
            "type": "integer",
            "format": "int32",
            "description": "1:充值,2:提现,3:支付,4:冻结,5:解冻,6:透支,7:还款,8:奖励"
          },
          "fromwallet": {
            "type": "integer",
            "format": "int64"
          },
          "towallet": {
            "type": "integer",
            "format": "int64"
          },
          "money": {
            "type": "number",
            "format": "double"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "1:待处理,2:已完成,3:失败,4:已取消"
          },
          "orderId": {
            "type": "integer",
            "format": "int64"
          },
          "description": {
            "type": "string"
          },
